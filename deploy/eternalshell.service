# EternalShell watcher: samples the server and mails CPU alerts.
# Installed by deploy/install.sh to /etc/systemd/system/eternalshell.service.
#
# Secrets: the SMTP password is NOT in this file or in config.yaml. It lives in
# /etc/eternalshell/secret.env (root, 0600) and systemd (running as root) hands
# it to the service as an environment variable.
#
# Docker: the service user is in the "docker" group so it can read container
# names and compose labels. Access to the Docker socket is root-equivalent;
# EternalShell only makes read-only API calls, but the group membership itself
# is powerful. A read-only socket proxy is the safer alternative.

[Unit]
Description=EternalShell watcher (CPU alerts by mail)
Wants=network-online.target
After=network-online.target docker.service
# A broken config makes the service exit at start. Stop retrying after 5 tries
# in 10 minutes instead of looping forever.
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=eternalshell
Group=eternalshell
EnvironmentFile=/etc/eternalshell/secret.env
ExecStart=/usr/local/bin/eternalshell watch --config /etc/eternalshell/config.yaml

# Restart after a crash or a failed start, not after a normal stop.
Restart=on-failure
RestartSec=30s

# Logs go to the journal: journalctl -u eternalshell -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eternalshell

# --- Hardening -------------------------------------------------------------
# The watcher must read /proc of ALL processes (CPU, command line, cgroup), so
# ProtectProc= and ProcSubset= are deliberately NOT used.
NoNewPrivileges=yes
ProtectSystem=strict
# read-only, not "yes": compose projects and their bind-mounted data often live
# under /home, and the disk usage per project has to read them. Writing to
# /home stays blocked.
ProtectHome=read-only
PrivateTmp=yes
MemoryMax=256M

# AF_UNIX: Docker socket. AF_INET/AF_INET6: SMTP and DNS.
# If DNS or SMTP fails under this unit with "address family not supported",
# add AF_NETLINK here. It is not added up front.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# CAP_DAC_READ_SEARCH lets the service READ and traverse files and directories
# it has no permission for. It cannot write. It is needed for the disk usage:
#   - the container log files in /var/lib/docker/containers (that directory is
#     root-only, mode 0710), and
#   - bind-mounted project directories, which are often owned by container
#     users (for example uid 999 for postgres).
# The capability applies to the whole process; the code only stats and walks
# directories. The docker group membership is already root-equivalent, so this
# adds no new power in practice. Without it the disk numbers show "?" for logs
# and "+?" for bind mounts. Reading /proc of other users' processes needs no
# capability.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

# The one place the service may write: /var/lib/eternalshell, created by
# systemd for the service user and also writable under ProtectSystem=strict.
# It holds a small JSON file with the figures of the last status report, so the
# next report can say what changed. Everything else stays in memory.
# The service also finds it through $STATE_DIRECTORY.
StateDirectory=eternalshell
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
